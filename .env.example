# URL pubblico del server (serve a Vapi per mandare gli eventi della chiamata)
PUBLIC_BASE_URL=https://tuo-dominio.it

# Password per la dashboard /admin (utente: admin)
ADMIN_PASSWORD=cambiami

# Database SQLite
DATABASE_PATH=leads.db

# --- Chiamate vocali (Vapi) ---
# dry_run = non chiama davvero, scrive solo nei log (utile per i test)
VOICE_PROVIDER=dry_run
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Segreto condiviso: Vapi lo rimanda nell'header X-Vapi-Secret di ogni evento
VAPI_SERVER_SECRET=un-segreto-lungo
# Modello Claude usato dall'agente in chiamata
LLM_MODEL=claude-opus-5-5
# Voce (es. ElevenLabs multilingua con voce italiana)
VOICE_PROVIDER_NAME=11labs
VOICE_ID=
TRANSCRIBER_LANGUAGE=it

# --- Meta Lead Ads ---
META_VERIFY_TOKEN=un-token-a-scelta
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Google Ads lead form ---
GOOGLE_LEAD_KEY=chiave-impostata-nel-modulo-google

# --- Webhook generico (ManyChat, Zapier, Make, sito) ---
GENERIC_WEBHOOK_TOKEN=un-altro-token

# --- Google Calendar (account di servizio) ---
# Percorso del file JSON della chiave, oppure il suo contenuto in GOOGLE_SERVICE_ACCOUNT_JSON
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Notifiche (opzionale): POST JSON a ogni prenotazione/esito ---
NOTIFY_WEBHOOK_URL=

# --- Simulatore testuale (python -m app.simulate) ---
ANTHROPIC_API_KEY=
