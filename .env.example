# URL pubblico del server (serve a Vapi per mandare gli eventi della chiamata)
PUBLIC_BASE_URL=https://tuo-dominio.it

# Password per la dashboard /admin (utente: admin)
ADMIN_PASSWORD=cambiami

# Database SQLite
DATABASE_PATH=leads.db

# --- Come Vittoria contatta i lead ---
# chat     = si apre una chat sul sito appena il cliente invia il modulo (nessuna telefonata automatica)
# telefono = Vittoria chiama il lead con Vapi
MODALITA_CONTATTO=chat
# Se il cliente non apre la chat entro questi minuti, il responsabile riceve un'email per richiamarlo
CHAT_ATTESA_MINUTI=30
# Se la chat resta ferma senza un esito per questi minuti, il responsabile riceve la conversazione per ricontattarlo
CHAT_INATTIVITA_MINUTI=30

# --- Chiamate vocali (Vapi) ---
# dry_run = non chiama davvero, scrive solo nei log (utile per i test)
VOICE_PROVIDER=dry_run
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Segreto condiviso: Vapi lo rimanda nell'header X-Vapi-Secret di ogni evento
VAPI_SERVER_SECRET=un-segreto-lungo
# Modello Claude usato dall'agente (in chiamata e in chat)
LLM_MODEL=claude-sonnet-4-6
# Voce (es. ElevenLabs multilingua con voce italiana)
VOICE_PROVIDER_NAME=azure
VOICE_ID=it-IT-ElsaNeural
TRANSCRIBER_LANGUAGE=it

# --- Meta Lead Ads ---
META_VERIFY_TOKEN=un-token-a-scelta
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Google Ads lead form ---
GOOGLE_LEAD_KEY=chiave-impostata-nel-modulo-google

# --- Webhook generico (ManyChat, Zapier, Make, sito) ---
GENERIC_WEBHOOK_TOKEN=un-altro-token

# --- Google Calendar (account di servizio) ---
# Percorso del file JSON della chiave, oppure il suo contenuto in GOOGLE_SERVICE_ACCOUNT_JSON
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Messaggi al cliente: conferma e promemoria (SMS ed email) ---
# 1 = invio reale; altrimenti i messaggi vengono solo scritti nei log
MESSAGGI_ATTIVI=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Mittente degli SMS: un numero Twilio abilitato agli SMS oppure un nome (es. MIFIT)
TWILIO_SMS_FROM=MIFIT
# Email via SMTP (es. Brevo: smtp-relay.brevo.com, porta 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MIFIT <info@tuodominio.it>

# --- Notifiche (opzionale): POST JSON a ogni prenotazione/esito ---
NOTIFY_WEBHOOK_URL=

# --- Claude per la chat e per il simulatore (python -m app.simulate) ---
ANTHROPIC_API_KEY=
